{
    "name": "aixueyuan/image-captcha",
    "description": "Image captcha for Flarum registration",
    "type": "flarum-extension",
    "require": {
        "flarum/core": "^1.0.0"
    },
    "autoload": {
        "psr-4": {
            "aixueyuan\\ImageCaptcha\\": "src/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Image Captcha",
            "icon": {
                "name": "fas fa-robot",
                "backgroundColor": "#238c59",
                "color": "#fff"
            }
        }
    }
}